@using System.Reflection
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration


@inject Microsoft.FeatureManagement.IFeatureManager featureManager


<!doctype html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <title>SRE .NET Demo App: @ViewData["Title"]</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Bootstrap & Bootswatch -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.1.3/pulse/bootstrap.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>

  <!-- Fontawesome icons -->
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.1/css/all.css" />

  <title>SRE .NET Demo App: @ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/site.css" />

  @Html.Raw(AppInsightsSnippet.FullScript)
</head>

<body>
  <div class="d-flex">
    <!-- Left sidebar navigation -->
    <div class="sidebar bg-primary">
      <a class="navbar-brand" href="/">
        <img src="/img/icon.svg" class="align-top" />
        <span class="ms-2">SRE .NET Demo App</span>
      </a>
      
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link btn btn-primary btn-lg mb-2" href="/info">
            <i class="fas fa-info-circle fa-fw"></i>
            Info
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link btn btn-primary btn-lg mb-2" href="/tools">
            <i class="fas fa-tools fa-fw"></i>
            Tools
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link btn btn-primary btn-lg mb-2" href="/monitor">
            <i class="fas fa-chart-line fa-fw"></i>
            Monitor
          </a>
        </li>

        <feature name="WeatherAPI">
          <li class="nav-item">
            <a class="nav-link btn btn-primary btn-lg mb-2" href="/weather">
              <i class="fas fa-cloud-sun-rain fa-fw"></i>
              Weather
            </a>
          </li>
        </feature>
      </ul>

      <div class="mt-auto">
        <partial name="_UserPartial" />
      </div>
    </div>
    
    <!-- Main content area -->
    <div class="main-content">
      <div class="container pt-4">
        @RenderBody()
      </div>
    </div>
  </div>
</body>

</html>